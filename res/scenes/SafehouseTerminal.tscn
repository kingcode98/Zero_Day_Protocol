[gd_scene format=3 uid="uid://safeterminal"]

[ext_resource type="Script" uid="uid://interactable" path="res://scripts/interactable.gd" id="1_INTERACTABLE"]
[ext_resource type="Script" uid="uid://terminalscript" path="res://scripts/safehouse_terminal.gd" id="1_TERMINALSCRIPT"]
[ext_resource type="Script" uid="uid://globals" path="res://autoload/Globals.gd" id="1_GLOBALS"]

[node name="SafehouseTerminal" type="Area2D"]
    script = ExtResource("1_TERMINALSCRIPT")

    [node name="Interaction" type="Interactable"]
        name = "Interaction"
        interaction_radius = 35
        interaction_text = "Access Terminal"

    [node name="Sprite2D" type="Sprite2D"]
        name = "TerminalScreen"
        texture = "res://assets/sprites/tileset.png"  # Placeholder - should be terminal sprite
        region_enabled = true
        region_rect = Rect2(64, 0, 32, 32)  # Assuming a tile in the tileset
        scale = Vector2(2.0, 2.0)

    [node name="CollisionShape2D" type="CollisionShape2D"]
        name = "InteractionCollision"
        shape = CircleShape2D
        radius = 35

    [node name="UIPanel" type="CanvasLayer" visible=false]
        name = "TerminalUI"
        [node name="Panel" type="PanelContainer"]
            anchor_left = 0.5
            anchor_top = 0.5
            margin_left = -150
            margin_top = -100
            anchor_right = 0.5
            anchor_bottom = 0.5
            [node name="VBoxContainer" type="VBoxContainer"]
                [node name="TitleLabel" type="Label"]
                    name = "TitleLabel"
                    text = "SAFEHOUSE TERMINAL"
                    align = 2
                    custom_minimum_size = Vector2(300, 40)
                [node name="Separator" type="HSeparator"]
                [node name="ScrollContainer" type="ScrollContainer"]
                    anchor_left = 0.0
                    anchor_top = 1.0
                    margin_bottom = -10
                    margin_left = 10
                    anchor_right = 1.0
                    margin_right = 10
                    [node name="TextEdit" type="TextEdit"]
                        name = "TerminalOutput"
                        readonly = true
                        wrap_enabled = true
                [node name="HBoxContainer" type="HBoxContainer"]
                    [node name="CloseButton" type="Button"]
                        name = "CloseButton"
                        text = "Close"
                        custom_minimum_size = Vector2(80, 30)
                        anchor_right = 1.0
                        anchor_bottom = 1.0
                        margin_left = -80
                        margin_bottom = -30