[node name="NPC_Hacker" type="Area2D"]
    script = ExtResource("1_NPCSCRIPT")

    [node name="Interaction" type="Interactable"]
        name = "Interaction"
        interaction_radius = 40
        interaction_text = "Hack"

    [node name="Sprite2D" type="Sprite2D"]
